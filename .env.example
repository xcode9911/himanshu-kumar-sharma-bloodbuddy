# Example environment variables for BloodBuddy backend
# Copy this file to .env and fill in real values.

PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here

# Primary SMTP (optional)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Brevo SMTP (fallback for nodemailer)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=aa41b8001@smtp-brevo.com
BREVO_SMTP_PASS=your_brevo_smtp_password_here

# Resend (API-based fallback)
RESEND_API_KEY=your_resend_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bloodbuddy
